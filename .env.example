# Générer avec : openssl rand -hex 32 (32 caractères minimum, sinon le serveur refuse de démarrer en production)
JWT_SECRET=

# Adresse de contact des notifications push (certains services la vérifient) ; sinon ADMIN_EMAIL est utilisé
VAPID_SUBJECT=mailto:vaillant.g@outlook.com

# Premier démarrage seulement : crée l'administrateur. Une fois connecté, ces trois lignes peuvent être supprimées ;
# les autres comptes et familles se créent depuis la page Admin.
ADMIN_EMAIL=vaillant.g@outlook.com
ADMIN_NAME=Grégoire
ADMIN_PASSWORD=

# Page Médias : clés gratuites des bases de données (facultatives, la recherche du type concerné est désactivée sans clé)
# TMDB (films, séries) : themoviedb.org → Réglages → API ; clé v3 ou « jeton d'accès en lecture » (v4)
TMDB_API_KEY=
# IGDB (jeux vidéo) : compte développeur Twitch gratuit (dev.twitch.tv/console → Enregistrer une application), identifiant et secret client. Les livres (Open Library) n'ont pas besoin de clé.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
