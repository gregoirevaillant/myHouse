generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Household {
  id            String         @id @default(cuid())
  name          String
  // pages activées pour cette famille (modules séparés par des virgules, voir src/modules.ts) ; réglé par l'administrateur
  features      String         @default("")
  users         User[]
  cards         LoyaltyCard[]
  meals         Meal[]
  shoppingItems ShoppingItem[]
  expenses      Expense[]
  expenseTrackers ExpenseTracker[]
  products      Product[]
  journals      Journal[]
  budgetItems     BudgetItem[]
  restaurants     Restaurant[]
  infos           HouseInfo[]
  recipes         Recipe[]
  calorieEntries  CalorieEntry[]
  mediaItems      MediaItem[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  isAdmin      Boolean   @default(false) // peut créer des familles et régler leurs pages (page Admin)
  sessionVersion Int     @default(0) // incrémenté au changement de mot de passe : coupe les anciennes sessions
  mustChangePassword Boolean @default(false) // compte créé ou réinitialisé par l'administrateur
  householdId  String
  household    Household @relation(fields: [householdId], references: [id])
  // chemins des onglets masqués dans la barre de menu, séparés par des virgules
  calorieGoal  Int? // objectif quotidien en kcal
  hiddenTabs   String    @default("")
  menuOrder    String    @default("") // ordre des pages (routes en CSV), commun à la barre et à l'accueil
  homeWide     String    @default("/repas") // tuiles de l'accueil sur 2 colonnes
  hiddenHome   String    @default("") // pages masquées sur l'accueil (indépendant de la barre de menu)
  showNavBar   Boolean   @default(true)
  // types de notifications coupés (SHOPPING, EXPENSES), séparés par des virgules
  mutedNotifications String @default("")
  paid         Expense[]
  pushSubscriptions PushSubscription[]
  shares       ExpenseShare[]
}

// ownerId: null = partagé dans le foyer, renseigné = privé (pour plus tard)
model LoyaltyCard {
  id            String    @id @default(cuid())
  householdId   String
  household     Household @relation(fields: [householdId], references: [id])
  createdById   String
  ownerId       String?
  name          String
  type          String // BARCODE | QR | NUMBER
  value         String?
  barcodeFormat String?
  imagePath     String?
  description   String?
  color         String
  createdAt     DateTime  @default(now())
}

model Meal {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  createdById String
  ownerId     String?
  date        String // YYYY-MM-DD
  slot        String // LUNCH | DINNER
  text        String
  // repas prévu au restaurant (bouton « Prévoir » d'un resto)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@unique([householdId, date, slot])
}

model ShoppingItem {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  createdById String
  ownerId     String?
  label       String
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  checked     Boolean   @default(false)
  checkedAt   DateTime?
  createdAt   DateTime  @default(now())
}

// Produit habituel du catalogue des courses. nameKey = nom normalisé (minuscules, sans accents) pour le rapprochement.
model Product {
  id            String         @id @default(cuid())
  householdId   String
  household     Household      @relation(fields: [householdId], references: [id])
  createdById   String
  ownerId       String?
  name          String
  nameKey       String
  note          String?
  imagePath     String?
  shoppingItems ShoppingItem[]
  createdAt     DateTime       @default(now())

  @@unique([householdId, nameKey])
}

// Restaurant du foyer : testé (au moins une visite) ou à tester
model Restaurant {
  id          String            @id @default(cuid())
  householdId String
  household   Household         @relation(fields: [householdId], references: [id])
  createdById String
  ownerId     String?
  name        String
  cuisine     String // id de la liste fixe (JAPONAIS…) ou texte libre
  district    String? // "11e" pour Paris, sinon nom de la ville
  address     String?
  lat         Float?
  lng         Float?
  wishlist    Boolean           @default(true) // true = à tester ; passe à false à la 1re visite
  rating      Int? // 1 à 5
  price       Int? // 1 à 3 (€ / €€ / €€€)
  phone       String?
  url         String?
  visits      RestaurantVisit[]
  meals       Meal[]
  createdAt   DateTime          @default(now())
}

model RestaurantVisit {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  date         String // YYYY-MM-DD

  @@unique([restaurantId, date])
}

// Carnet de dépenses partagé (vie quotidienne, voyage en Norvège…)
model ExpenseTracker {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  createdById String
  ownerId     String?
  name        String
  emoji       String
  // carnet terminé (YYYY-MM-DD) : rangé à part, ouvert sur son bilan ; null = en cours
  finishedAt  String?
  expenses    Expense[]
  createdAt   DateTime  @default(now())
}

// Montants en centimes. Un remboursement est une dépense payée par le débiteur, attribuée au créancier.
model Expense {
  id              String         @id @default(cuid())
  householdId     String
  household       Household      @relation(fields: [householdId], references: [id])
  createdById     String
  ownerId         String?
  trackerId       String
  tracker         ExpenseTracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  title           String
  amountCents     Int
  paidById        String
  paidBy          User           @relation(fields: [paidById], references: [id])
  date            String // YYYY-MM-DD
  isReimbursement Boolean        @default(false)
  shares          ExpenseShare[]
  createdAt       DateTime       @default(now())

  @@index([householdId, date])
  @@index([trackerId])
}

model ExpenseShare {
  id          String  @id @default(cuid())
  expenseId   String
  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId      String
  user        User    @relation(fields: [userId], references: [id])
  amountCents Int

  @@unique([expenseId, userId])
}

// Journal intime : ownerId = auteur, visible de lui seul
model Journal {
  id          String         @id @default(cuid())
  householdId String
  household   Household      @relation(fields: [householdId], references: [id])
  createdById String
  ownerId     String?
  title       String
  entries     JournalEntry[]
  createdAt   DateTime       @default(now())
}

model JournalEntry {
  id        String   @id @default(cuid())
  journalId String
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  text      String
  updatedAt DateTime @updatedAt

  @@unique([journalId, date])
}

// Budget saisi à la main : charges et revenus mensuels ou annuels. ownerId null = partagé, sinon privé à cette personne.
model BudgetItem {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  createdById String
  ownerId     String?
  label       String
  kind        String // EXPENSE | INCOME
  period      String // MONTHLY | YEARLY
  amountCents Int // toujours positif, le sens vient de kind
  category    String
  dueDay      Int // 1-31 (ramené à la fin du mois si besoin)
  dueMonth    Int? // 1-12, seulement pour YEARLY
  active      Boolean   @default(true)
  note        String?
  createdAt   DateTime  @default(now())

  @@index([householdId, ownerId])
}

// Repas saisi dans le suivi des calories : toujours privé (ownerId = la personne)
model CalorieEntry {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  createdById String
  ownerId     String
  date        String // YYYY-MM-DD
  meal        String // BREAKFAST | LUNCH | DINNER | SNACK
  label       String
  kcal        Int
  createdAt   DateTime  @default(now())

  @@index([householdId, ownerId, date])
}

// Abonnement Web Push d'un appareil (un par navigateur / téléphone)
model PushSubscription {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId String
  endpoint    String   @unique
  p256dh      String
  auth        String
  createdAt   DateTime @default(now())
}

// infos utiles : digicode, Wi-Fi, numéros, jour des poubelles…
model HouseInfo {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  createdById String
  ownerId     String? // null = partagée, sinon visible par cette personne seulement
  category    String // CODE | WIFI | CONTACT | MAISON | AUTRE
  label       String
  value       String
  note        String?
  createdAt   DateTime  @default(now())

  @@index([householdId])
}

// Recette du foyer. Ingrédients et étapes : une ligne chacun.
model Recipe {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  createdById String
  ownerId     String?
  name        String
  category    String // PLAT | ENTREE | DESSERT | APERO | PETIT_DEJ | AUTRE
  servings    Int?
  calories    Int? // kcal par portion (ou pour 100 g si per100g)
  per100g     Boolean   @default(false) // calories données pour 100 g (produit scanné) et non par portion
  minutes     Int? // temps total
  ingredients String    @default("")
  steps       String    @default("")
  note        String?
  url         String? // source (site, vidéo…)
  imagePath   String?
  createdAt   DateTime  @default(now())

  @@index([householdId])
}

// Suivi de ce qu'on regarde, joue ou lit (films, séries ; jeux et livres à venir). Visibilité comme HouseInfo : ownerId null = partagé.
model MediaItem {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  createdById String
  ownerId     String?
  kind        String // MOVIE | SERIES | GAME | BOOK
  title       String
  year        Int?
  creator     String? // réalisateur, studio, auteur… (texte libre)
  overview    String?
  status      String // WISHLIST | IN_PROGRESS | DONE
  progress    String? // « S2 E5 », « p. 120 »… texte libre
  rating      Int? // 1 à 5
  doneAt      String? // YYYY-MM-DD, fin du visionnage / de la partie / de la lecture
  note        String?
  source      String? // base ouverte d'où vient la fiche : tvmaze | wikidata
  sourceId    String?
  imagePath   String?
  createdAt   DateTime  @default(now())
}
