generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Household {
  id            String         @id @default(cuid())
  name          String
  users         User[]
  cards         LoyaltyCard[]
  meals         Meal[]
  shoppingItems ShoppingItem[]
  expenses      Expense[]
  expenseTrackers ExpenseTracker[]
  products      Product[]
  journals      Journal[]
  bankConnections BankConnection[]
  categoryRules   CategoryRule[]
  recurringItems  RecurringItem[]
  restaurants     Restaurant[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  householdId  String
  household    Household @relation(fields: [householdId], references: [id])
  // chemins des onglets masqués dans la barre de menu, séparés par des virgules
  hiddenTabs   String    @default("")
  showNavBar   Boolean   @default(true)
  // types de notifications coupés (SHOPPING, MEALS, EXPENSES, BUDGET, DIGEST), séparés par des virgules
  mutedNotifications String @default("")
  paid         Expense[]
  pushSubscriptions PushSubscription[]
  shares       ExpenseShare[]
}

// ownerId: null = partagé dans le foyer, renseigné = privé (pour plus tard)
model LoyaltyCard {
  id            String    @id @default(cuid())
  householdId   String
  household     Household @relation(fields: [householdId], references: [id])
  createdById   String
  ownerId       String?
  name          String
  type          String // BARCODE | QR | NUMBER
  value         String?
  barcodeFormat String?
  imagePath     String?
  description   String?
  color         String
  createdAt     DateTime  @default(now())
}

model Meal {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  createdById String
  ownerId     String?
  date        String // YYYY-MM-DD
  slot        String // LUNCH | DINNER
  text        String
  // repas prévu au restaurant (bouton « Prévoir » d'un resto)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@unique([householdId, date, slot])
}

model ShoppingItem {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  createdById String
  ownerId     String?
  label       String
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  checked     Boolean   @default(false)
  checkedAt   DateTime?
  createdAt   DateTime  @default(now())
}

// Produit habituel du catalogue des courses. nameKey = nom normalisé (minuscules, sans accents) pour le rapprochement.
model Product {
  id            String         @id @default(cuid())
  householdId   String
  household     Household      @relation(fields: [householdId], references: [id])
  createdById   String
  ownerId       String?
  name          String
  nameKey       String
  note          String?
  imagePath     String?
  shoppingItems ShoppingItem[]
  createdAt     DateTime       @default(now())

  @@unique([householdId, nameKey])
}

// Restaurant du foyer : testé (au moins une visite) ou à tester
model Restaurant {
  id          String            @id @default(cuid())
  householdId String
  household   Household         @relation(fields: [householdId], references: [id])
  createdById String
  ownerId     String?
  name        String
  cuisine     String // id de la liste fixe (JAPONAIS…) ou texte libre
  district    String? // "11e" pour Paris, sinon nom de la ville
  address     String?
  lat         Float?
  lng         Float?
  wishlist    Boolean           @default(true) // true = à tester ; passe à false à la 1re visite
  rating      Int? // 1 à 5
  price       Int? // 1 à 3 (€ / €€ / €€€)
  phone       String?
  url         String?
  visits      RestaurantVisit[]
  meals       Meal[]
  createdAt   DateTime          @default(now())
}

model RestaurantVisit {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  date         String // YYYY-MM-DD

  @@unique([restaurantId, date])
}

// Carnet de dépenses partagé (vie quotidienne, voyage en Norvège…)
model ExpenseTracker {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  createdById String
  ownerId     String?
  name        String
  emoji       String
  expenses    Expense[]
  createdAt   DateTime  @default(now())
}

// Montants en centimes. Un remboursement est une dépense payée par le débiteur, attribuée au créancier.
model Expense {
  id              String         @id @default(cuid())
  householdId     String
  household       Household      @relation(fields: [householdId], references: [id])
  createdById     String
  ownerId         String?
  trackerId       String
  tracker         ExpenseTracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  title           String
  amountCents     Int
  paidById        String
  paidBy          User           @relation(fields: [paidById], references: [id])
  date            String // YYYY-MM-DD
  isReimbursement Boolean        @default(false)
  shares          ExpenseShare[]
  createdAt       DateTime       @default(now())

  @@index([householdId, date])
  @@index([trackerId])
}

model ExpenseShare {
  id          String  @id @default(cuid())
  expenseId   String
  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId      String
  user        User    @relation(fields: [userId], references: [id])
  amountCents Int

  @@unique([expenseId, userId])
}

// Journal intime : ownerId = auteur, visible de lui seul
model Journal {
  id          String         @id @default(cuid())
  householdId String
  household   Household      @relation(fields: [householdId], references: [id])
  createdById String
  ownerId     String?
  title       String
  entries     JournalEntry[]
  createdAt   DateTime       @default(now())
}

model JournalEntry {
  id        String   @id @default(cuid())
  journalId String
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  text      String
  updatedAt DateTime @updatedAt

  @@unique([journalId, date])
}

// Budget personnel, alimenté par la banque (Enable Banking) : tout est privé, ownerId = la personne connectée
model BankConnection {
  id           String        @id @default(cuid())
  householdId  String
  household    Household     @relation(fields: [householdId], references: [id])
  ownerId      String
  aspspName    String
  aspspCountry String
  sessionId    String
  validUntil   DateTime
  accounts     BankAccount[]
  createdAt    DateTime      @default(now())
}

model BankAccount {
  id           String            @id @default(cuid())
  connectionId String
  connection   BankConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  ownerId      String
  uid          String
  name         String
  iban         String?
  accountType  String? // CACC (courant) | SVGS (épargne)…
  currency     String
  balanceCents Int?
  balanceAt    DateTime?
  lastSyncAt   DateTime?
  transactions BankTransaction[]
}

// Montant signé en centimes (négatif = sortie). labelKey = libellé normalisé, sert aux règles et au récurrent.
model BankTransaction {
  id               String      @id @default(cuid())
  accountId        String
  account          BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId       String
  date             String // YYYY-MM-DD
  amountCents      Int
  label            String
  labelKey         String
  counterparty     String?
  counterpartyIban String?
  mcc              String?
  category         String
  categorySource   String // AUTO | RULE | USER
  recurringId      String?

  @@unique([accountId, externalId])
  @@index([accountId, date])
}

// Catégorie apprise : tout libellé normalisé contenant pattern reçoit category
model CategoryRule {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  ownerId     String
  pattern     String
  category    String

  @@unique([ownerId, pattern])
}

// Flux récurrent détecté (abonnement, salaire, loyer, épargne programmée…)
model RecurringItem {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  ownerId     String
  key         String // labelKey + sens (in/out)
  label       String
  category    String
  period      String // WEEKLY | MONTHLY | QUARTERLY | YEARLY
  amountCents Int // montant habituel, signé
  lastDate    String // YYYY-MM-DD
  nextDate    String // YYYY-MM-DD
  status      String // ACTIVE | ENDED | DISMISSED
  createdAt   DateTime  @default(now())

  @@unique([ownerId, key])
}

// Abonnement Web Push d'un appareil (un par navigateur / téléphone)
model PushSubscription {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId String
  endpoint    String   @unique
  p256dh      String
  auth        String
  createdAt   DateTime @default(now())
}

// Dernière exécution d'une tâche planifiée (évite de la rejouer après un redémarrage)
model JobRun {
  name    String @id
  lastRun String // YYYY-MM-DD
}
