generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Household {
  id            String         @id @default(cuid())
  name          String
  users         User[]
  cards         LoyaltyCard[]
  meals         Meal[]
  shoppingItems ShoppingItem[]
  expenses      Expense[]
  products      Product[]
  journals      Journal[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  householdId  String
  household    Household @relation(fields: [householdId], references: [id])
  // chemins des onglets masqués dans la barre de menu, séparés par des virgules
  hiddenTabs   String    @default("")
  paid         Expense[]
  shares       ExpenseShare[]
}

// ownerId: null = partagé dans le foyer, renseigné = privé (pour plus tard)
model LoyaltyCard {
  id            String    @id @default(cuid())
  householdId   String
  household     Household @relation(fields: [householdId], references: [id])
  createdById   String
  ownerId       String?
  name          String
  type          String // BARCODE | QR | NUMBER
  value         String?
  barcodeFormat String?
  imagePath     String?
  description   String?
  color         String
  createdAt     DateTime  @default(now())
}

model Meal {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  createdById String
  ownerId     String?
  date        String // YYYY-MM-DD
  slot        String // LUNCH | DINNER
  text        String

  @@unique([householdId, date, slot])
}

model ShoppingItem {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  createdById String
  ownerId     String?
  label       String
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  checked     Boolean   @default(false)
  checkedAt   DateTime?
  createdAt   DateTime  @default(now())
}

// Produit habituel du catalogue des courses. nameKey = nom normalisé (minuscules, sans accents) pour le rapprochement.
model Product {
  id            String         @id @default(cuid())
  householdId   String
  household     Household      @relation(fields: [householdId], references: [id])
  createdById   String
  ownerId       String?
  name          String
  nameKey       String
  note          String?
  imagePath     String?
  shoppingItems ShoppingItem[]
  createdAt     DateTime       @default(now())

  @@unique([householdId, nameKey])
}

// Montants en centimes. Un remboursement est une dépense payée par le débiteur, attribuée au créancier.
model Expense {
  id              String         @id @default(cuid())
  householdId     String
  household       Household      @relation(fields: [householdId], references: [id])
  createdById     String
  ownerId         String?
  title           String
  amountCents     Int
  paidById        String
  paidBy          User           @relation(fields: [paidById], references: [id])
  date            String // YYYY-MM-DD
  isReimbursement Boolean        @default(false)
  shares          ExpenseShare[]
  createdAt       DateTime       @default(now())

  @@index([householdId, date])
}

model ExpenseShare {
  id          String  @id @default(cuid())
  expenseId   String
  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId      String
  user        User    @relation(fields: [userId], references: [id])
  amountCents Int

  @@unique([expenseId, userId])
}

// Journal intime : ownerId = auteur, visible de lui seul
model Journal {
  id          String         @id @default(cuid())
  householdId String
  household   Household      @relation(fields: [householdId], references: [id])
  createdById String
  ownerId     String?
  title       String
  entries     JournalEntry[]
  createdAt   DateTime       @default(now())
}

model JournalEntry {
  id        String   @id @default(cuid())
  journalId String
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  text      String
  updatedAt DateTime @updatedAt

  @@unique([journalId, date])
}
